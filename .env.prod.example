# Copie este archivo a .env y complete los valores antes de desplegar.
#   cp .env.prod.example .env
# Nunca suba .env a Git.

# Dominio que apunta a la IP publica de la VM.
# Gratis con DuckDNS: https://www.duckdns.org  (ej. onda-demo.duckdns.org)
APP_DOMAIN=onda-demo.duckdns.org

# Contrasena de MySQL. Use una larga y unica.
MYSQL_ROOT_PASSWORD=

# Secreto de firma de los JWT. Genere uno con:
#   openssl rand -base64 48
# Debe ser Base64 de 32+ bytes o texto de 32+ caracteres.
JWT_SECRET=

# Opcional: clave gratuita de https://finnhub.io para cotizaciones de acciones.
# Sin clave, las criptomonedas siguen funcionando.
FINNHUB_API_KEY=

# Opcional: origenes extra permitidos por CORS (separados por coma).
# No hace falta si el frontend se sirve desde el mismo dominio.
# Ejemplo: https://mi-frontend.vercel.app
CORS_ALLOWED_ORIGINS=
